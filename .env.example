# ===== API =====
PORT=4000
NODE_ENV=development
API_URL=http://localhost:4000

# URL(s) do frontend permitidas no CORS (separadas por vírgula em produção)
FRONTEND_URL=http://localhost:3000

# ===== Database =====
DATABASE_URL=postgresql://saas_docs:saas_docs_password@localhost:5432/saas_docs?schema=public

# ===== Redis (Bull queues) =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== JWT =====
JWT_ACCESS_SECRET=your-access-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===== Web (Next.js) =====
# Em produção deve ser a URL pública da API (ex: https://api.o-teu-dominio.com)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=SaaS Docs

# ===== Encryption =====
ENCRYPTION_KEY=your-encryption-key-change-in-production
