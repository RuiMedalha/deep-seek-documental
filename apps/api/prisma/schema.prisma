// ============================================
// Deep Seek Documental - Schema Prisma (FINAL)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgresql://saas_docs:saas_docs_password@127.0.0.1:5434/saas_docs?schema=public"
}

// ============ ENUMS ============

enum Role {
  ADMIN
  CONTABILIDADE
  OPERADOR
  APROVADOR
}

enum DocumentOrigin {
  UPLOAD
  EMAIL
  SCANNER
  MOBILE
  WHATSAPP
}

enum DocumentType {
  FATURA_RECEBIDA
  FATURA_EMITIDA
  RECIBO
  COMPROVATIVO
  ENCOMENDA
  OUTRO
}

enum DocumentStatus {
  NOVO
  PROCESSADO
  EM_REVISAO
  ARQUIVADO
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  SCHEDULED
}

enum RecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ContactType {
  INDIVIDUAL
  COMPANY
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
  FOLLOW_UP
}

// ============ MODELOS PRINCIPAIS ============

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  users       User[]
  documents   Document[]
  folders     Folder[]
  bankTransactions BankTransaction[]
  expenses    Expense[]
  invoices    Invoice[]
  integrations Integration[]
  csvTemplates CsvTemplate[]
  paymentSchedules PaymentSchedule[]
  crmContacts CrmContact[]
  deals       Deal[]
  activities  Activity[]
  crmPipelines CrmPipeline[]
  
  @@index([slug])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         Role     @default(OPERADOR)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  
  canViewBankValues    Boolean @default(false)
  canViewReconciliation Boolean @default(false)
  canApprovePayments   Boolean @default(false)
  canExportData        Boolean @default(false)
  permissions          Json?
  
  twoFactorSecret      String?
  twoFactorEnabled     Boolean @default(false)
  
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]
  documents    Document[]
  paymentSchedules PaymentSchedule[]
  activitiesAssigned Activity[] @relation("ActivityAssignedTo")
  activitiesCreated  Activity[] @relation("ActivityCreatedBy")
  deals        Deal[]
  notifications Notification[]
  
  @@index([tenantId, role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
  
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  
  @@index([tenantId, createdAt])
}

// ============ DOCUMENTOS ============

model Document {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  fileName        String
  filePath        String
  fileHash        String
  mimeType        String
  size            Int
  origin          DocumentOrigin
  type            DocumentType @default(OUTRO)
  status          DocumentStatus @default(NOVO)
  supplierCustomer String?
  nif             String?
  documentDate    DateTime?
  dueDate         DateTime?
  total           Decimal?     @db.Decimal(10, 2)
  iva             Decimal?     @db.Decimal(10, 2)
  currency        String       @default("EUR")
  tags            String[]
  suggestedFolder String?
  finalFolder     String?
  metadata        Json?
  
  crmContactId    String?
  crmContact      CrmContact?  @relation(fields: [crmContactId], references: [id])
  
  uploadedById    String
  uploadedBy      User         @relation(fields: [uploadedById], references: [id])
  
  expenses        Expense[]
  invoices        Invoice[]
  paymentSchedules PaymentSchedule[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([tenantId, status])
  @@index([tenantId, fileHash])
  @@index([tenantId, documentDate])
}

model Folder {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  pattern   String
  rules     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([tenantId, name])
}

// ============ FINANCEIRO ============

model BankTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  date        DateTime
  description String
  amount      Decimal  @db.Decimal(10, 2)
  balance     Decimal? @db.Decimal(10, 2)
  reference   String?
  rawRowJson  Json
  fileHash    String
  importBatch String
  
  expenses    Expense[]
  invoices    Invoice[]
  
  createdAt   DateTime @default(now())
  
  @@index([tenantId, date])
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  category    String?
  
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  bankTransactionId String?
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  
  status      String   @default("pendente")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId, date])
}

model Invoice {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  number      String
  supplier    String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime
  dueDate     DateTime?
  
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  bankTransactionId String?
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  crmContactId String?
  crmContact  CrmContact? @relation(fields: [crmContactId], references: [id])
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id])
  
  paymentSchedules PaymentSchedule[]
  
  status      String   @default("pendente")
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId, date])
  @@index([tenantId, status])
}

model PaymentSchedule {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  title       String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("EUR")
  dueDate     DateTime
  paymentDate DateTime?
  status      PaymentStatus @default(PENDING)
  category    String?
  paymentMethod String?
  
  recurring   Boolean  @default(false)
  recurrenceType RecurrenceType?
  recurrenceInterval Int?
  
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id])
  invoiceId   String?
  invoice     Invoice?  @relation(fields: [invoiceId], references: [id])
  crmContactId String?
  crmContact  CrmContact? @relation(fields: [crmContactId], references: [id])
  
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([tenantId, dueDate])
  @@index([tenantId, status])
}

// ============ CRM ============

model CrmContact {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        ContactType @default(COMPANY)
  name        String
  nif         String?
  email       String?
  phone       String?
  mobile      String?
  address     String?
  city        String?
  postalCode  String?
  country     String   @default("Portugal")
  website     String?
  industry    String?
  notes       String?
  tags        String[]
  isActive    Boolean  @default(true)
  
  contactPersons ContactPerson[]
  deals       Deal[]
  activities  Activity[]
  documents   Document[]
  invoices    Invoice[]
  payments    PaymentSchedule[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([tenantId, name])
  @@index([tenantId, email])
}

model ContactPerson {
  id          String   @id @default(cuid())
  contactId   String
  contact     CrmContact @relation(fields: [contactId], references: [id])
  name        String
  role        String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Deal {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contactId   String
  contact     CrmContact @relation(fields: [contactId], references: [id])
  title       String
  value       Decimal  @db.Decimal(10, 2)
  stage       DealStage @default(LEAD)
  probability Int      @default(20)
  expectedCloseDate DateTime?
  wonAt       DateTime?
  lostAt      DateTime?
  
  invoices    Invoice[]
  activities  Activity[]
  
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([tenantId, stage])
}

model Activity {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  contactId   String?
  contact     CrmContact? @relation(fields: [contactId], references: [id])
  dealId      String?
  deal        Deal?      @relation(fields: [dealId], references: [id])
  type        ActivityType
  subject     String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  
  assignedToId String?
  assignedTo  User?      @relation("ActivityAssignedTo", fields: [assignedToId], references: [id])
  createdById String
  createdBy   User       @relation("ActivityCreatedBy", fields: [createdById], references: [id])
  
  createdAt   DateTime   @default(now())
  
  @@index([tenantId, dueDate])
}

model CrmPipeline {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  stages      Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============ INTEGRAÇÕES ============

model Integration {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  type        String
  credentials Json
  config      Json?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([tenantId, type])
}

model CsvTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  mapping     Json
  dateFormat  String
  decimalSeparator String @default(",")
  createdAt   DateTime @default(now())
  
  @@unique([tenantId, name])
}

// ============ NOTIFICAÇÕES ============

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  
  @@index([tenantId, userId, read])
}